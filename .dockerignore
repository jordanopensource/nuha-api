# Git
.git/
.gitignore

# CI/CD
.woodpecker/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.eggs/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Ruff
.ruff_cache/

# Documentation
*.md
docs/

# Docker (don't include Dockerfile in the image)
Dockerfile*
compose.yml
compose.yaml
compose.dev.yml
.docker/

# Environment and config files (not needed in container)
.env*
*.log

# Config files (development/CI tools, not needed at runtime)
.gitleaks.toml
.pre-commit-config.yaml
.ruff.toml
.samplr.yml
.yamllint
LICENSE

# Development tooling (not needed in container), EXCEPT the two scripts the
# image ships: the fetch service's installer and the schema-validation CLI.
scripts/*
!scripts/fetch_models.py
!scripts/validate_dialects.py

# Local model directories (models never enter the image; they live on the
# models volume, installed by the fetch service)
model/
models/
