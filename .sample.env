# =============================================================================
# Nuha API - Runtime Environment Configuration
# =============================================================================
# This file configures the API at RUNTIME (when the container starts).
# Run `samplr` to generate .sample.env from this file.
#
# NOTE: This file holds RUNTIME config only. Model repos are not set here.
# Each dialect's hf_repo lives in app/dialects/<code>.json (read at build time).
#
# DIALECT is set per-service in compose.yml (DIALECT=arz, acm, or ckb),
# not here. This file is for settings shared across all dialect instances.
#
# DEFAULTS: All variables have sensible defaults in the Python code.
# You only need to set variables here if you want to override those defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Classification Engine
# -----------------------------------------------------------------------------

# Concurrent inference slots: at most this many inferences RUN at once. Sizes
# both the thread pool and the execution-slot count. Inference is CPU bound, so
# the best setting is one in-flight inference per CPU the container is allowed
# (BACKEND_CPU_LIMIT). Keep CLASSIFIER_WORKERS equal to BACKEND_CPU_LIMIT, with
# ORT_INTRA_OP_THREADS at 1 (see below). Setting it higher oversubscribes the CPU
# and, under a Docker cpu cap, triggers CFS throttling that slows down every
# inference (I measured 4 workers on a 2 cpu cap running about 3x slower than 2).
# For responsiveness under load, give the backend ~0.5-1 CPU of headroom above
# this (BACKEND_CPU_LIMIT slightly above CLASSIFIER_WORKERS) so the event loop,
# tokenization, and /health are not starved while every slot is busy.
#samplr#CLASSIFIER_WORKERS=2
CLASSIFIER_WORKERS=2

# Admission queue in front of the execution slots. A request that finds every
# slot busy WAITS up to INFERENCE_QUEUE_TIMEOUT seconds for one to free instead
# of being shed immediately, so short bursts are served (200) rather than 503'd
# the instant both workers are busy. At most CLASSIFIER_WORKERS +
# INFERENCE_QUEUE_SIZE requests are in flight (running + waiting); beyond that,
# or once the wait deadline passes, the API sheds a fast 503 so latency/memory
# stay bounded. The queue smooths bursts WITHIN capacity; it does not add
# throughput (sustained load above capacity still sheds; add replicas instead).
# Set INFERENCE_QUEUE_SIZE=0 for the old no-queue, shed-immediately behavior.
# Memory: each in-flight request can hold a body up to the nginx
# client_max_body_size (10m), so keep mem_limit above
# model_size + (CLASSIFIER_WORKERS + INFERENCE_QUEUE_SIZE) x that body cap. If you
# raise this for a burst, raise the dialect mem_limit too or you risk an OOM.
#samplr#INFERENCE_QUEUE_SIZE=32
INFERENCE_QUEUE_SIZE=32

# Seconds a queued request waits for a slot before shedding 503. Part of the
# request latency budget: nginx proxy_read_timeout must stay above
# INFERENCE_QUEUE_TIMEOUT + INFERENCE_TIMEOUT (currently 30 + 120 = 150 < 155s).
#samplr#INFERENCE_QUEUE_TIMEOUT=30
INFERENCE_QUEUE_TIMEOUT=30

# ONNX Runtime threads PER inference. Keep at 1 so each inference is single
# threaded and the CLASSIFIER_WORKERS slots run one per core with no
# oversubscription. ORT otherwise sizes its intra-op pool to the HOST core count
# and ignores the Docker cpu cap, the same CFS-throttle trap the old torch
# OMP/MKL thread vars had. Rule of thumb:
# CLASSIFIER_WORKERS x ORT_INTRA_OP_THREADS should be about BACKEND_CPU_LIMIT. To
# favor fewer but faster (multi threaded) batches over concurrency, raise this
# and lower CLASSIFIER_WORKERS to keep that product the same. (Replaces the
# torch-only OMP_NUM_THREADS / MKL_NUM_THREADS.)
#samplr#ORT_INTRA_OP_THREADS=1
ORT_INTRA_OP_THREADS=1

# Maximum number of texts in one /classify/batch request. A batch runs as a
# single inference that holds one of the CLASSIFIER_WORKERS slots until it
# finishes, so a very large batch can block a slot for a long time (I measured a
# full 1000-text batch at tens of seconds on a 2 cpu cap), and nginx
# proxy_read_timeout has to cover that. Lower this if you want batches to hold a
# slot for less time and interleave better with single requests.
#samplr#MAX_BATCH_SIZE=1000
MAX_BATCH_SIZE=1000

# Per-request inference timeout in seconds. This is a safety backstop, not a
# tuning knob: a request whose inference runs past this gets a 504 and its
# worker slot is reclaimed once the stuck work ends. Set it well ABOVE the
# worst-case legitimate batch on your hardware so it only ever fires when
# something is genuinely wrong (a full 1000-text batch is one inference and took
# tens of seconds on a 2 cpu cap, so 120s leaves wide margin). nginx
# proxy_read_timeout must stay above this so the app's own 504 reaches the client.
#samplr#INFERENCE_TIMEOUT=120
INFERENCE_TIMEOUT=120

# Number of unique preprocessed texts to cache (LRU eviction)
# Avoids redundant model inference for repeated inputs
# Set to 0 to effectively disable caching (minimum 1 entry)
#samplr#CACHE_SIZE=1024
CACHE_SIZE=1024

# Expose inference cache statistics on the /health endpoint.
# Off by default: /health is served unauthenticated via nginx, and cache
# hit/miss counts leak traffic signals. Set to any value to enable for
# trusted/internal monitoring.
# EXPOSE_CACHE_STATS=1


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#samplr#LOG_LEVEL=INFO
LOG_LEVEL=INFO

# Log output format
# Options:
#   - "text": Human-readable format (recommended for development)
#   - "json": Structured JSON format (recommended for production/log aggregation)
#samplr#LOG_FORMAT=text
LOG_FORMAT=text


# -----------------------------------------------------------------------------
# Server Configuration (Uvicorn)
# -----------------------------------------------------------------------------

# Host address to bind the server to
# Use "0.0.0.0" to accept connections from any interface
#samplr#HOST=0.0.0.0
HOST=0.0.0.0

# Port number for the HTTP server
#samplr#PORT=8000
PORT=8000

# Number of Uvicorn worker processes. Keep at 1. Inference runs in a thread pool
# that releases the GIL during the model forward pass, so one process already
# uses all the CPU the container is given. Each extra worker is a full copy of
# the model in memory with its own gate and cache, and I measured no throughput
# gain from 2 workers (same req/s, about 2x the memory). Scale with
# BACKEND_CPU_LIMIT and CLASSIFIER_WORKERS, or run more container replicas.
#samplr#WORKERS=1
WORKERS=1

# Uvicorn keep-alive timeout in seconds (how long an idle client connection is
# held open). This is NOT a request or inference timeout, so it does not need to
# grow for large batches. The backstop for a slow or stuck inference is nginx
# proxy_read_timeout in nginx.conf, which must exceed your worst-case batch time.
#samplr#TIMEOUT=120
TIMEOUT=120


# -----------------------------------------------------------------------------
# Advanced Configuration (rarely needed)
# -----------------------------------------------------------------------------

# Override the model directory path.
# Normally auto-derived from DIALECT (./models/{DIALECT} locally,
# /home/appuser/models/{DIALECT} in the container).
# Only override if mounting a custom model location.
#samplr#MODEL_PATH=
MODEL_PATH=


# -----------------------------------------------------------------------------
# Container Resource Limits (compose.yml)
# -----------------------------------------------------------------------------
# Caps applied per container by compose so one backend can't starve the others
# or the host. Tune to your model size and traffic; defaults shown.
#
# BACKEND_CPU_LIMIT is the anchor for inference tuning: keep CLASSIFIER_WORKERS
# equal to it and ORT_INTRA_OP_THREADS at 1 (see the Classification Engine section).
# Throughput scales about linearly with this value (I measured roughly 2x the
# req/s going from a 2 cpu to a 4 cpu cap). Provision the host with at least
# (number of dialects x BACKEND_CPU_LIMIT) physical cores so the backends do not
# fight for CPU at peak.
#
# Per-dialect MEMORY limits are NOT set here. Each dialect's mem_limit lives in
# app/dialects/<code>.json (rendered into compose.yml by scripts/render_config.py)
# so a heavier model like ckb (XLM-R) can get more room than the BERT dialects.
#samplr#BACKEND_CPU_LIMIT=2.0
BACKEND_CPU_LIMIT=2.0
#samplr#BACKEND_MEM_RESERVATION=512m
BACKEND_MEM_RESERVATION=512m
#samplr#PROXY_CPU_LIMIT=1.0
PROXY_CPU_LIMIT=1.0
#samplr#PROXY_MEM_LIMIT=256m
PROXY_MEM_LIMIT=256m


# -----------------------------------------------------------------------------
# Horizontal Scaling (replicas per dialect)
# -----------------------------------------------------------------------------
# Each dialect runs as a Compose service that can scale to N replicas. The proxy
# load-balances across them automatically (round-robin via Docker DNS), so this
# adds capacity for a burst without changing the image or the proxy.
#
# The baseline replica count is per-dialect config, so it lives in the dialect
# file, NOT here: set "replicas" in app/dialects/<code>.json (next to mem_limit)
# and re-run scripts/render_config.py. Default 1 = the original single-container
# behaviour. There is intentionally no <CODE>_REPLICAS variable in this shared
# file, because a per-dialect value does not belong in shared config.
#
# Sizing: each replica gets BACKEND_CPU_LIMIT cores and runs CLASSIFIER_WORKERS
# concurrent inferences, so to serve ~N batches at once on a dialect set its
# "replicas" to about N / CLASSIFIER_WORKERS (at CLASSIFIER_WORKERS=2, replicas=10
# serves ~20 concurrent batches). The host needs
# (sum of replicas x BACKEND_CPU_LIMIT) cores available at that moment.
#
# Bursty workload (e.g. workshops): for an ad-hoc ramp without editing files,
# override at runtime (no rebuild, no downtime for running replicas):
#   docker compose up -d --scale nuha-api-arz=10   # ramp up for a workshop
#   docker compose up -d --scale nuha-api-arz=1    # back to baseline after
# Keep at least 1 so the dialect always answers; a dialect at 0 replicas fails
# its requests until scaled back up.


# -----------------------------------------------------------------------------
# CI/CD Secrets (Reference Only)
# -----------------------------------------------------------------------------
# These must be configured as secrets in Woodpecker CI, not in .env files.
#
# Build-time secrets:
#   (none): all model repos are public, downloaded anonymously at build time
#
# CI secrets:
#   REGISTRY_USERNAME      - Registry username for pushing images
#   REGISTRY_SECRET        - Registry password or access token
#   SLACK_WEBHOOK          - Slack webhook URL for build notifications
#
# Model repos are NOT configured here. Each dialect's HuggingFace repo lives in
# app/dialects/<code>.json ("hf_repo"); the Dockerfile reads those at build time.
