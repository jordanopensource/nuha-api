# =============================================================================
# EgyNuha API - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
#
# DEFAULTS: All variables have sensible defaults defined in the Python code.
# You only need to set variables here if you want to override those defaults.
# The values shown below are the defaults - uncomment and modify as needed.
# =============================================================================


# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# HuggingFace repository ID for the classification model
# Used during Docker build to download the model
# Format: "username/repo-name" or "organization/repo-name"
# HF_MODEL_REPO="SafwanLjd/egynuha-classifier"


# Local path where the model is stored inside the container
# Only change this if you have a custom model mounting strategy
# Default is set in Dockerfile to match where model is copied
# MODEL_PATH="/home/appuser/model"


# -----------------------------------------------------------------------------
# Classification Engine
# -----------------------------------------------------------------------------

# Number of worker threads for concurrent classification requests
# Recommended: Set to number of CPU cores available
# Higher values improve throughput but increase memory usage
# CLASSIFIER_WORKERS="4"

# Maximum number of texts allowed in a single batch request
# Increase for higher throughput, decrease to limit memory usage per request
# MAX_BATCH_SIZE="1000"


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL="INFO"

# Log output format
# Options:
#   - "text": Human-readable format (recommended for development)
#   - "json": Structured JSON format (recommended for production/log aggregation)
# LOG_FORMAT="text"


# -----------------------------------------------------------------------------
# Server Configuration (Uvicorn)
# -----------------------------------------------------------------------------

# Host address to bind the server to
# Use "0.0.0.0" to accept connections from any interface
# HOST="0.0.0.0"

# Port number for the HTTP server
# PORT="8000"

# Number of Uvicorn worker processes
# Recommended: (2 x CPU cores) + 1 for production
# Note: Keep at 1 if using GPU inference to avoid memory issues
# WORKERS="1"

# Request timeout in seconds
# Increase if processing large batches
# TIMEOUT="120"


# -----------------------------------------------------------------------------
# CI/CD Variables (Set automatically by Woodpecker CI)
# -----------------------------------------------------------------------------
# These are injected during build and should not be set manually.
# Documented here for reference only.
#
# CI_REPO              - Full repository path (e.g., "org/repo")
# CI_REPO_NAME         - Repository name only
# CI_REPO_URL          - Repository URL
# CI_COMMIT_SHA        - Full commit SHA
# CI_COMMIT_REF        - Git reference (branch/tag)
# CI_PIPELINE_URL      - URL to the current pipeline
# CI_PIPELINE_CREATED  - Pipeline creation timestamp
# CI_PREV_PIPELINE_URL - URL to the previous pipeline
# CI_PIPELINE_NUMBER   - Sequential pipeline number


# -----------------------------------------------------------------------------
# CI/CD Secrets (Configure in Woodpecker UI)
# -----------------------------------------------------------------------------
# These must be configured as secrets in Woodpecker CI, not in .env files.
# Documented here for reference only.
#
# DOCKER_HUB_USERNAME  - Docker Hub username for pushing images
# DOCKER_HUB_PASSWORD  - Docker Hub password or access token
# SLACK_WEBHOOK        - Slack webhook URL for build notifications
# HF_TOKEN             - (Optional) HuggingFace token, in case the model becomes private/gated in the future