# =============================================================================
# Nuha API - Runtime Environment Configuration
# =============================================================================
# This file configures the API at runtime (when the container starts).
# Run `samplr` to generate .sample.env from this file.
#
# NOTE: This file holds runtime config only. The served dialects are not set
# here: the api serves whatever the models volume holds. models-init populates
# the volume before the api starts, and `docker compose run --rm fetch`
# changes it (followed by `docker compose restart api`). Each dialect's
# hf_repo lives in app/dialects/<code>.json, read at install time.
#
# Defaults: every variable has a sensible default in the Python code.
# You only need to set variables here if you want to override those defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Models Volume
# -----------------------------------------------------------------------------

# Where the model directories live: one <code>/ subdirectory per dialect,
# holding dialect.json plus the model snapshot. Compose mounts the models
# volume at /models and sets this there (read-only for the api; models-init
# and fetch write it); the local-dev default is ./models, and an empty value
# below means that default too, not the current directory. The api scans it
# once at startup, so volume changes are picked up by restarting the api.
#samplr#MODELS_DIR=
MODELS_DIR=


# -----------------------------------------------------------------------------
# Classification Engine
# -----------------------------------------------------------------------------

# Concurrent inference slots for the whole process, shared by every loaded
# dialect: at most this many inferences run at once. Sizes both the thread pool
# and the execution-slot count. Inference is CPU bound, so the best setting is
# one in-flight inference per CPU the container is allowed (API_CPU_LIMIT),
# with ORT_INTRA_OP_THREADS at 1 (see below). Setting it higher oversubscribes
# the CPU and, under a Docker cpu cap, triggers CFS throttling that slows down
# every inference (I measured 4 workers on a 2 cpu cap running about 3x slower
# than 2). For responsiveness under load, give the container ~0.5-1 CPU of
# headroom above this (API_CPU_LIMIT slightly above CLASSIFIER_WORKERS) so the
# event loop, tokenization, and /health are not starved while every slot is busy.
#samplr#CLASSIFIER_WORKERS=2
CLASSIFIER_WORKERS=2

# Admission queue in front of the execution slots. A request that finds every
# slot busy waits up to INFERENCE_QUEUE_TIMEOUT seconds for one to free instead
# of being shed immediately, so short bursts are served (200) rather than 503'd
# the instant both workers are busy. At most CLASSIFIER_WORKERS +
# INFERENCE_QUEUE_SIZE requests are in flight (running + waiting); beyond that,
# or once the wait deadline passes, the API sheds a fast 503 so latency/memory
# stay bounded. The queue smooths bursts within capacity; it does not add
# throughput (sustained load above capacity still sheds; add replicas instead).
# Set INFERENCE_QUEUE_SIZE=0 for the old no-queue, shed-immediately behavior.
# Memory: each in-flight request can hold a body up to MAX_BODY_SIZE (10 MiB),
# so keep API_MEM_LIMIT above the loaded models' total plus
# (CLASSIFIER_WORKERS + INFERENCE_QUEUE_SIZE) x that body cap. If you raise
# this for a burst, raise API_MEM_LIMIT too or you risk an OOM.
#samplr#INFERENCE_QUEUE_SIZE=32
INFERENCE_QUEUE_SIZE=32

# Seconds a queued request waits for a slot before shedding 503. Part of the
# request latency budget: the compose stop_grace_period must stay above
# INFERENCE_QUEUE_TIMEOUT + INFERENCE_TIMEOUT (currently 30 + 120 = 150 < 160s)
# so a restart drains admitted work instead of killing it.
#samplr#INFERENCE_QUEUE_TIMEOUT=30
INFERENCE_QUEUE_TIMEOUT=30

# ONNX Runtime threads per inference. Keep at 1 so each inference is single
# threaded and the CLASSIFIER_WORKERS slots run one per core with no
# oversubscription. ORT otherwise sizes its intra-op pool to the host core count
# and ignores the Docker cpu cap, re-creating the CFS-throttle slowdown the
# old torch thread vars hit. Rule of thumb:
# CLASSIFIER_WORKERS x ORT_INTRA_OP_THREADS should be about API_CPU_LIMIT. To
# favor fewer but faster (multi threaded) batches over concurrency, raise this
# and lower CLASSIFIER_WORKERS to keep that product the same. (Replaces the
# torch-only OMP_NUM_THREADS / MKL_NUM_THREADS.)
#samplr#ORT_INTRA_OP_THREADS=1
ORT_INTRA_OP_THREADS=1

# Maximum number of texts in one /classify/batch request. A batch runs as one
# forward pass per ensemble member (one for a single model), each holding a
# CLASSIFIER_WORKERS slot until it finishes, so a very large batch can block a
# slot for a while (I measured a 1000-text single-model batch at tens of seconds
# on a 2 cpu cap; an ensemble multiplies that by its member count). Lower this if
# you want batches to hold a slot for less time and interleave better with single
# requests.
#samplr#MAX_BATCH_SIZE=1000
MAX_BATCH_SIZE=1000

# Request body cap in bytes (default 10 MiB). The api enforces this itself
# (oversized requests get a 413, declared or chunked), so a directly exposed
# container cannot be fed an arbitrarily large body and OOM-killed; the
# platform edge can add its own lower bound on top.
#samplr#MAX_BODY_SIZE=10485760
MAX_BODY_SIZE=10485760

# Per-request inference timeout in seconds. This is a safety backstop, not a
# tuning knob: a request whose inference runs past this gets a 504 and its
# worker slot is reclaimed once the stuck work ends. Set it well above the
# worst-case legitimate batch on your hardware so it only ever fires when
# something is genuinely wrong (a 1000-text batch is one forward pass per member
# and took tens of seconds on a 2 cpu cap for a single model, so 120s leaves
# margin; an ensemble batch scales with its member count, so size this above the
# worst case on your hardware). The compose stop_grace_period must stay above
# INFERENCE_QUEUE_TIMEOUT + this value.
#samplr#INFERENCE_TIMEOUT=120
INFERENCE_TIMEOUT=120

# Number of unique preprocessed texts to cache per dialect (LRU eviction; each
# loaded dialect gets its own cache so keys cannot collide across dialects).
# Avoids redundant model inference for repeated inputs. Memory scales with the
# number of loaded dialects. Set to 0 to disable caching.
#samplr#CACHE_SIZE=1024
CACHE_SIZE=1024

# Expose per-dialect inference cache statistics on the /health endpoint.
# Off by default: /health is served unauthenticated, and cache hit/miss counts
# leak traffic signals. Presence-based: setting it to any value (even 0 or
# false) enables it; keep the line commented out to keep it off. Enable only
# for trusted/internal monitoring.
# EXPOSE_CACHE_STATS=1

# Interactive API docs (/docs, /redoc, /openapi.json) are disabled by default in
# production: they are the one unauthenticated path that isn't classification
# traffic, and most deployments never use them. Remove (or comment out) the line
# below to serve the docs.
#samplr#DISABLE_DOCS=1
DISABLE_DOCS=1


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#samplr#LOG_LEVEL=INFO
LOG_LEVEL=INFO

# Log output format
# Options:
#   - "text": Human-readable format (recommended for development)
#   - "json": Structured JSON format (recommended for production/log aggregation)
#samplr#LOG_FORMAT=text
LOG_FORMAT=text


# -----------------------------------------------------------------------------
# Server Configuration (Uvicorn)
# -----------------------------------------------------------------------------

# The server binds 0.0.0.0:8000 inside the container, fixed in the image
# entrypoint (like --workers 1); there is no host bind knob. PORT below only
# sets the published host port.

# Host port the api is published on (compose maps ${PORT}:8000).
#samplr#PORT=8000
PORT=8000

# Uvicorn worker processes are fixed at 1 in the image entrypoint; there is no
# WORKERS variable. Inference runs in a thread pool that releases the GIL during
# the model forward pass, so one process already uses all the CPU the container
# is given; each extra worker would be a full copy of every model in memory with
# its own gate and caches for no throughput gain (measured: same req/s, ~2x the
# memory). Scale concurrency with CLASSIFIER_WORKERS (shared models, parallel
# inferences) and container replicas instead.

# Uvicorn keep-alive timeout in seconds (how long an idle client connection is
# held open). This is not a request or inference timeout, so it does not need
# to grow for large batches; the app's own 503/504 budget covers slow work.
#samplr#TIMEOUT=120
TIMEOUT=120


# -----------------------------------------------------------------------------
# Image Source (compose.yml)
# -----------------------------------------------------------------------------
# Compose assembles the api/fetch image ref as <NUHA_API_IMAGE>:<NUHA_API_TAG>.
# Both unset (the default) = build and run the local nuha-api:local image. To
# run CI-published images, point at the registry repo AND pick a channel: CI
# publishes channel-first tags (stable-api from main, latest-api from branches,
# each with a <channel>-<sha>-api pin for rollback) and no bare tag, so a
# deploy always states its channel.
# NUHA_API_IMAGE=registry.cloud.josa.ngo/library/nuha-api
# NUHA_API_TAG=stable-api


# -----------------------------------------------------------------------------
# Container Resource Limits (compose.yml)
# -----------------------------------------------------------------------------
# Caps applied to the api container by compose so it can't starve the host.
#
# API_CPU_LIMIT is the anchor for inference tuning: keep CLASSIFIER_WORKERS
# about one below it and ORT_INTRA_OP_THREADS at 1 (see the Classification
# Engine section). Throughput scales about linearly with this value (I measured
# roughly 2x the req/s going from a 2 cpu to a 4 cpu cap).
#
# API_MEM_LIMIT must cover the sum of every loaded model in one process, and an
# ensemble dialect is the sum of its members (the shipped set, one single model
# plus two four-member ensembles, holds ~3.8 GiB loaded) plus the web stack, the
# per-dialect caches, and in-flight bodies. Installing more dialects, or swapping
# a single model for an ensemble, raises the real footprint: raise this with the
# volume. The compose.dev.yml override caps it at 7g for an 8 GiB dev host.
#samplr#API_CPU_LIMIT=3.0
API_CPU_LIMIT=3.0
#samplr#API_MEM_LIMIT=10g
API_MEM_LIMIT=10g


# -----------------------------------------------------------------------------
# CI/CD Secrets (Reference Only)
# -----------------------------------------------------------------------------
# These must be configured as secrets in Woodpecker CI, not in .env files.
#
# CI secrets:
#   REGISTRY_USERNAME      - Registry username for pushing images
#   REGISTRY_SECRET        - Registry password or access token
#   SLACK_WEBHOOK          - Slack webhook URL for build notifications
#
# Model repos are not configured here. Each dialect's HuggingFace repo lives in
# app/dialects/<code>.json ("hf_repo"); the fetch command reads those at
# install time, anonymously (all model repos are public).
